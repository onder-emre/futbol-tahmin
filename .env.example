# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=futbol_tahmin
DB_USER=postgres
DB_PASSWORD=

# --- API-Football (https://dashboard.api-football.com) ---
API_FOOTBALL_KEY=
API_RATE_LIMIT_PER_MINUTE=10     # Free: 10, Pro: 300
API_DAILY_QUOTA_RESERVE=5        # Günlük kotadan her zaman yedekte bırakılacak istek

# --- Pipeline (boş bırakılırsa: tüm ligler, son 10 sezon) ---
# LEAGUE_IDS=203,39,140,135,78,61
# START_SEASON=2017
# END_SEASON=2026

# --- Telegram (FAZ 4) — kurulum: README "Telegram botu" bölümü ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Günlük iş (FAZ 5) ---
TIMEZONE=Europe/Istanbul
CONFIDENCE_THRESHOLD=0.55        # Mesaja girecek minimum olasılık
RETRAIN_DAYS=7                   # Model bundan eskiyse yeniden eğit
DAILY_MAX_REQUESTS=60            # Günlük işin harcayabileceği en fazla API isteği
