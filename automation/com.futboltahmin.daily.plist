<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd ajanı: her sabah 09:00'da günlük işi arka planda çalıştırır.
  Kurulum : automation/install.sh   (bu dosyayı ~/Library/LaunchAgents/ altına kopyalar)
  __PROJECT_DIR__ yer tutucusu kurulumda gerçek yolla değiştirilir.
-->
<plist version="1.0">
<dict>
    <!-- Ajanın benzersiz adı (launchctl komutlarında kullanılır) -->
    <key>Label</key>
    <string>com.futboltahmin.daily</string>

    <!-- Çalıştırılacak komut -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/automation/run_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Her gün 09:00. Mac o saatte uykudaysa, uyanınca BİR KEZ çalışır (cron'dan farkı). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Yüklendiğinde hemen çalıştırma; sadece takvimde çalışsın -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Çıktılar (run_daily.sh + main.py logları ayrıca logs/daily.log'a yazılır) -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>

    <!-- Arka plan işi: düşük öncelik, kullanıcıyı yavaşlatmasın -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>tr_TR.UTF-8</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
